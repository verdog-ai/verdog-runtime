// Written by `plumbcheck sync` into .plumbcheck/ from verdog-ai/standards;
// edit it there. A repository overrides a setting in its own file, which
// extends this one; paths here start at .plumbcheck/.
// Only settings that differ from pyright's defaults, each with its reason.
{
  // The strict rule set (default: standard).
  "typeCheckingMode": "strict",
  // The oldest Python the organization supports (default: the interpreter's).
  "pythonVersion": "3.12",
  // Resolve imports in the project's uv environment (default: the PATH's).
  "venvPath": "..",
  "venv": ".venv",
  // Environments, build output and fixtures; the list replaces the default
  // one, so node_modules and __pycache__ are named again.
  "exclude": ["../.venv", "../.verdog", "../build", "../dist", "../node_modules", "../**/__pycache__", "../**/fixtures"],
  // A module with stubs but no installed source is an error, not a warning.
  "reportMissingModuleSource": "error",
  // Off even in strict mode: overrides need @override, and unneeded ignores and
  // unreachable code are errors.
  "reportImplicitOverride": "error",
  "reportUnnecessaryTypeIgnoreComment": "error",
  "reportUnreachable": "error"
}
